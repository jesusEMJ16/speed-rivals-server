# Node does not auto-load .env. Configure these in your hosting environment.
NODE_ENV=production
PORT=8787

# Preferred: reuse the existing Upstash database, with a NEW v2 key.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SR_STORAGE_KEY=sr:v2:state

# Alternative to Upstash: absolute path on a mounted persistent disk.
# SR_DATA_FILE=/var/data/speed-rivals/online-v2.json

# Optional trusted override for invitation Play on web links; room=ABC123 is appended.
# When empty, invitations open this server's bundled /play/?room=ABC123 game.
# For an external override, use a directly playable HTML URL, not an itch.io store page.
SR_WEB_PLAY_URL=

# Public SHA-256 signing certificate fingerprint from Google Play App Signing.
# 32 hex byte pairs separated by colons; comma-separate multiple release certificates.
# Not a password. Do not substitute the debug or upload certificate for the Play signing certificate.
# Empty/invalid configuration makes /.well-known/assetlinks.json return 503 with no association.
SR_ANDROID_CERT_SHA256=
